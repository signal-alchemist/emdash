{
  "$schema": "../../plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "sa-content-insights",
  // Add the publisher DID before marketplace publication.
  "license": "MIT",
  "author": { "name": "signal-alchemist" },
  "security": { "url": "https://github.com/signal-alchemist/emdash/security/advisories/new" },
  "description": "Editorial analytics snapshots, experiments, and improvement proposals for EmDash.",
  "capabilities": ["content:read"],
  "allowedHosts": [],
  "storage": {
    "snapshots": { "indexes": ["targetKey", "generatedAt"] },
    "experiments": { "indexes": ["targetKey", "status", "updatedAt"] },
    "proposals": { "indexes": ["targetKey", "status", "createdAt"] }
  },
  "admin": {
    "pages": [{ "path": "/insights", "label": "Content Insights", "icon": "chart-line-up" }],
    "widgets": [{ "id": "insight-summary", "title": "Content Insights", "size": "half" }]
  }
}
