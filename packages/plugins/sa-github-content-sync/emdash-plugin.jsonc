{
	"$schema": "../../plugin-cli/schemas/emdash-plugin.schema.json",
	"slug": "sa-github-content-sync",
	"publisher": "signal-alchemist.github.io", // TODO: publication is blocked until this handle resolves to the org's verified atproto DID.
	"license": "MIT",
	"author": { "name": "signal-alchemist" },
	"security": { "url": "https://github.com/signal-alchemist/emdash/security/advisories/new" },
	"description": "Revision-safe GitHub article and media synchronization for EmDash.",
	"capabilities": ["content:write", "media:write", "network:request"],
	"allowedHosts": ["api.github.com", "raw.githubusercontent.com"],
	"storage": {
		"sync_runs": {
			"indexes": ["deliveryId", "commitSha", "sourcePath", "contentId", "status", "createdAt"]
		},
		"sync_mappings": {
			"indexes": [
				"repository",
				"branch",
				"sourcePath",
				"locale",
				"contentId",
				"status",
				"lastCommitSha"
			]
		},
		"sync_attempts": {
			"indexes": [
				"deliveryId",
				"repository",
				"commitSha",
				"planDigest",
				"state",
				"createdAt",
				"predecessorAttempt"
			]
		}
	},
	"admin": {
		"pages": [{ "path": "/deliveries", "label": "Content Sync", "icon": "arrows-clockwise" }],
		"widgets": [{ "id": "sync-status", "title": "Content Sync", "size": "third" }]
	}
}
